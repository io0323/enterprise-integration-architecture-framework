{
  "realm": "eiaf",
  "enabled": true,
  "displayName": "EIAF Local",
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "clientScopes": [
    {
      "name": "sales.order:read",
      "description": "注文の参照(Framework 12.3。contracts/openapi/order-api.v1.yaml)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "sales.order:write",
      "description": "注文の登録(Framework 12.3。contracts/openapi/order-api.v1.yaml)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "sales.order:report",
      "description": "注文の日次の集計の参照(件数とハッシュだけ。分析の照合用。P08。ADR-0031 §3。contracts/openapi/order-api.v1.yaml)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "inventory.stock:read",
      "description": "在庫の照会(Framework 12.3。contracts/proto/io/eia/inventory/v1/stock_query_service.proto。ADR-0042 §9)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "inventory-grpc-audience",
      "description": "aud に inventory-grpc を入れる(CLAUDE.md §5: JWT は aud を検証する)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience-inventory-grpc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "inventory-grpc",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "shipping.shipment:read",
      "description": "出荷の照会(Framework 12.3。contracts/proto/io/eia/shipping/v1/shipment_query_service.proto。ADR-0042 §9)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "shipping-grpc-audience",
      "description": "aud に shipping-grpc を入れる(CLAUDE.md §5: JWT は aud を検証する)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience-shipping-grpc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "shipping-grpc",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sales.order:read-address",
      "description": "注文の届け先の住所を BFF から読む(個人情報。ADR-0043 §7)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "bff-graphql-audience",
      "description": "aud に bff-graphql を入れる(画面のための集約を呼ぶクライアント。CLAUDE.md §5: JWT は aud を検証する)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience-bff-graphql",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "bff-graphql",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "order-api-audience",
      "description": "aud に order-api を入れる(CLAUDE.md §5: JWT は aud を検証する)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "audience-order-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "eiaf-e2e",
      "name": "E2E / 開発用の client-credentials クライアント",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EIAF_E2E_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["order-api-audience"],
      "optionalClientScopes": ["sales.order:read", "sales.order:write", "sales.order:report", "inventory.stock:read", "inventory-grpc-audience", "shipping.shipment:read", "shipping-grpc-audience", "sales.order:read-address", "bff-graphql-audience"]
    },
    {
      "clientId": "eiaf-e2e-b",
      "name": "E2E / 開発用の 2 つ目の client-credentials クライアント(クライアントごとの Rate Limit・冪等の範囲の確認)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EIAF_E2E_B_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["order-api-audience"],
      "optionalClientScopes": ["sales.order:read", "sales.order:write", "sales.order:report"]
    },
    {
      "clientId": "eiaf-batch-etl",
      "name": "分析のバッチ(batch-etl)の週次の照合。注文の日次の集計だけを読む(ADR-0031 §3・§6)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EIAF_BATCH_ETL_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["order-api-audience"],
      "optionalClientScopes": ["sales.order:report"]
    },
    {
      "clientId": "eiaf-b2b-gateway",
      "name": "B2B / EDI Gateway(b2b-gateway)。取引先から受け付けた注文を order の API で社内に取り込む。注文の登録だけ(ADR-0040 §6)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EIAF_B2B_GATEWAY_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["order-api-audience"],
      "optionalClientScopes": ["sales.order:write"]
    },
    {
      "clientId": "eiaf-bff-graphql",
      "name": "画面のための集約(bff-graphql)。注文・在庫・出荷を読むだけ。書き込みのスコープを持たない(confused deputy の緩和。ADR-0043 §7)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EIAF_BFF_GRAPHQL_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [],
      "optionalClientScopes": ["sales.order:read", "order-api-audience", "inventory.stock:read", "inventory-grpc-audience", "shipping.shipment:read", "shipping-grpc-audience"]
    }
  ]
}
