# E2E 用の設定(make up ... E2E=1 が docker compose の --env-file に足す)。値は infra/local/docker-compose.yml の ${...:-既定} を上書きする。
# 秘密情報は書かない(infra/local/.env にある)。
#
# file-exchange と b2b-gateway(FileExchangeE2E。P09 ⑦・P12 ⑦b)。E2E で確かめるのは「取引先の SFTP を本物に止めると、送信の失敗と
# Circuit Breaker の Open が Prometheus まで届くこと」と「戻した後に、次の回で送り終えること」で、判定の仕組み(Circuit Breaker の窓と失敗率・
# リトライの回数)は本番の既定のまま変えない。待ち時間だけを短くして、E2E の所要時間を延ばさない。
# - file-exchange の到着の確認の間隔: 30 秒 → 2 秒(マニフェストを置いてから受け取りが動くまでの待ち)
FILE_EXCHANGE_POLL_INTERVAL=2s
# - b2b-gateway が受け渡しの場所を見て取引先に送る間隔: 1 分 → 2 秒
B2B_GATEWAY_DELIVER_INTERVAL=2s
# - b2b-gateway の取引先の SFTP の見回り・応答の送信・社内への取り込みの間隔: 30 秒 → 2 秒
B2B_GATEWAY_POLL_INTERVAL=2s
B2B_GATEWAY_SEND_INTERVAL=2s
B2B_GATEWAY_SUBMIT_INTERVAL=2s
# - 取引先の Circuit Breaker の Open の期間: 30 秒 → 5 秒(戻した後に Half-Open になるまでの待ち)
B2B_GATEWAY_SFTP_OPEN_DURATION=5s

# SaaS 連携(SaasE2E。P10 ⑦)。判定の仕組み(署名の時刻の許容・新旧の判定・Resilience の再試行の回数)は変えず、待ち時間だけを短くする。
# - saas-mock の Webhook の再送の間隔: 5s,30s,2m,10m,1h,3h → 1s,2s,5s,10s(届かなかった Webhook の再送を E2E の時間の中で待てるように)
SAAS_MOCK_WEBHOOK_RETRY=1s,2s,5s,10s
# - integration-flow の定期の同期の間隔: 1 分 → 5 秒(429 の Backoff と、同期が古い版を出さないことを待てるように)
INTEGRATION_FLOW_POLL_INTERVAL=5s
# - 追加の Flow の定義(Flow の定義を足すだけで新しいマッピングを追加できることを確かめる。tests/e2e/flows。パスは compose のファイルからの相対)
INTEGRATION_FLOW_EXTRA_FLOWS=../../tests/e2e/flows

# 障害の注入の経路(FaultInjectionE2E・ResilienceE2E。ADR-0044)。接続先だけを Toxiproxy に切り替える(make up E2E=1 は chaos の profile を足す)
# - order-service → PostgreSQL(マイグレーションと Debezium は直接つなぐ)
ORDER_SERVE_DB_URL=jdbc:postgresql://toxiproxy:19433/order_service
# - bff-graphql → Gateway(注文の読み取り)
BFF_GATEWAY_URL=http://toxiproxy:19081
# - inventory-service → Kafka(TOXI_INTERNAL のリスナー。メタデータで返る接続先も Toxiproxy を指す)
INVENTORY_KAFKA_BOOTSTRAP=toxiproxy:19095
