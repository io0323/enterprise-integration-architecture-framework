{
  "type": "record",
  "name": "StockReleased",
  "namespace": "io.eia.events.inventory",
  "doc": "在庫を解放した(補償の完了)。引当がなかった場合も届く。(inventory.stock.released.v1)",
  "fields": [
    {
      "name": "sagaId",
      "type": "string",
      "doc": "Saga ID(UUIDv7。Kafka のキー = パーティションキー。受信側の業務キーの冪等の単位。ADR-0029)"
    },
    {
      "name": "orderId",
      "type": "string",
      "doc": "注文 ID"
    },
    {
      "name": "outcome",
      "type": {
        "type": "enum",
        "name": "StockReleaseOutcome",
        "doc": "UNKNOWN は読み手が知らない値(新しい版で増えた値)を読んだときの既定値(Avro の enum の default。FULL 互換で値を増やせるようにする。ADR-0029 §4)。送り手は使わない。",
        "symbols": [
          "RELEASED",
          "NOT_RESERVED",
          "UNKNOWN"
        ],
        "default": "UNKNOWN"
      }
    }
  ]
}
