{
  "type": "record",
  "name": "AuthorizePayment",
  "namespace": "io.eia.events.payment",
  "doc": "決済の承認(与信)の指示。同じ sagaId の 2 回目以降は、最初の結果を返し直す。(payment.payment.cmd-authorize.v1)",
  "fields": [
    {
      "name": "sagaId",
      "type": "string",
      "doc": "Saga ID(UUIDv7。Kafka のキー = パーティションキー。受信側の業務キーの冪等の単位。ADR-0029)"
    },
    {
      "name": "orderId",
      "type": "string",
      "doc": "注文 ID"
    },
    {
      "name": "customerId",
      "type": "string"
    },
    {
      "name": "amount",
      "type": {
        "type": "record",
        "name": "Money",
        "namespace": "io.eia.events.common",
        "doc": "金額。minorUnits は最小通貨単位(JPY は円、USD はセント)。小数桁数は currency から引く(ADR-0012)。",
        "fields": [
          {
            "name": "minorUnits",
            "type": "long"
          },
          {
            "name": "currency",
            "type": "string",
            "doc": "ISO 4217 の通貨コード"
          }
        ]
      }
    }
  ]
}
