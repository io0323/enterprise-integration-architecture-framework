{
  "name": "legacy-juchu",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
    "database.dbname": "legacy_sim",
    "topic.prefix": "_cdc.legacy",
    "plugin.name": "pgoutput",
    "publication.name": "eiaf_legacy",
    "publication.autocreate.mode": "disabled",
    "slot.name": "legacy_juchu",
    "table.include.list": "public.t_juchu",
    "message.key.columns": "public.t_juchu:col_02",
    "snapshot.mode": "initial",
    "signal.enabled.channels": "source",
    "signal.data.collection": "eiaf_cdc.debezium_signal",
    "incremental.snapshot.watermarking.strategy": "insert_delete",
    "decimal.handling.mode": "string",
    "time.precision.mode": "adaptive",
    "tombstones.on.delete": "false",
    "schema.name.adjustment.mode": "avro",
    "field.name.adjustment.mode": "avro",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT pg_logical_emit_message(true, 'eiaf-heartbeat', now()::text)",
    "key.converter": "io.apicurio.registry.utils.converter.AvroConverter",
    "key.converter.apicurio.registry.url": "http://apicurio:8080/apis/registry/v3",
    "key.converter.apicurio.registry.auto-register": "true",
    "key.converter.apicurio.registry.artifact.group-id": "cdc-raw",
    "key.converter.apicurio.registry.dereference-schema": "true",
    "value.converter": "io.apicurio.registry.utils.converter.AvroConverter",
    "value.converter.apicurio.registry.url": "http://apicurio:8080/apis/registry/v3",
    "value.converter.apicurio.registry.auto-register": "true",
    "value.converter.apicurio.registry.artifact.group-id": "cdc-raw",
    "value.converter.apicurio.registry.dereference-schema": "true",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3",
    "topic.creation.default.cleanup.policy": "delete",
    "topic.creation.default.retention.ms": "604800000"
  }
}
