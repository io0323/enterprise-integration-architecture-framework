    {
      "id": 2,
      "type": "timeseries",
      "title": "保持している WAL(遅延)と警告の閾値",
      "description": "レガシーのスロット legacy_juchu が読み終えていない WAL の量。上限の 25% を超えた状態が 5 分続くと CdcSlotLagHigh(cdc.rules.yml。スロットごとに判定する)。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "pg_replication_slots_pg_wal_lsn_diff{slot_name=\"legacy_juchu\"}",
          "legendFormat": "保持している WAL"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "0.25 * pg_settings_max_slot_wal_keep_size_bytes > 0",
          "legendFormat": "警告の閾値(上限の 25%)"
        }
      ]
    },
