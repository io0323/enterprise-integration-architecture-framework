{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eia.io/contracts/catalog/catalog.schema.json",
  "title": "Integration Catalog entry",
  "description": "連携カタログ 1 件の形式(Framework 16.1、INTEGRATION_STANDARDS §5)。1 ファイル 1 連携で、ファイル名は {id}.yaml。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "style", "pattern", "provider", "consumers", "contract", "tier", "dataClassification", "slo", "lifecycle"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INT-[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "style": {
      "enum": ["rest", "graphql", "grpc", "webhook", "mqtt", "event", "batch", "etl", "cdc", "file", "edi", "ipaas"]
    },
    "pattern": {
      "description": "queue はコマンドトピック(ADR-0006)",
      "enum": ["request-reply", "pub-sub", "queue", "scheduled", "file-transfer", "cdc"]
    },
    "provider": {
      "description": "提供側。pattern: queue(コマンド)では、コマンドを受信して処理するサービス",
      "$ref": "#/$defs/party"
    },
    "consumers": {
      "description": "利用側。event / cdc / queue では購読する Consumer Group ごとに 1 件。queue は受信サービスの 1 件だけ(ADR-0006)",
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "senders": {
      "description": "pattern: queue のコマンドを送信する側",
      "type": "array",
      "items": { "$ref": "#/$defs/party" }
    },
    "contract": {
      "description": "リポジトリルートからの相対パス",
      "type": "string",
      "pattern": "^contracts/"
    },
    "channels": {
      "description": "この連携が扱うトピック・MQTT トピック・ファイル仕様など。event / cdc / mqtt では必須",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tier": { "enum": [1, 2, 3] },
    "dataClassification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "latencyP99"],
      "properties": {
        "availability": { "type": "string", "pattern": "^[0-9]{2}(\\.[0-9]+)?$" },
        "latencyP99": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" }
      }
    },
    "audit": {
      "description": "この連携が記録する監査(platform/audit。ADR-0017 §1)。記録する連携では書く",
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "dataClassification", "retention"],
      "properties": {
        "actions": {
          "description": "記録する操作(audit.audit_log の action)",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" }
        },
        "dataClassification": {
          "description": "監査の記録の機密区分(actor_id などは個人データになりうる)",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "retention": {
          "description": "監査の記録の保持期間。legal は法令に従う(期間は環境ごとの設定)。または ISO 8601 の期間(例 P7Y)",
          "anyOf": [{ "const": "legal" }, { "type": "string", "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?$" }]
        }
      }
    },
    "lifecycle": { "enum": ["proposed", "design", "active", "deprecated", "retired"] },
    "deprecation": {
      "description": "廃止の予告(lifecycle: deprecated で必須。Framework 16.1・ADR-0034)。消費者に通知し、移行の期限を設ける",
      "type": "object",
      "additionalProperties": false,
      "required": ["sunset", "notice"],
      "properties": {
        "sunset": { "description": "移行の期限(この日の後に retired にできる)", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notice": { "description": "消費者への通知(Issue。例 #123)", "$ref": "#/$defs/issue" },
        "replacement": { "description": "移行先の連携 ID", "type": "string", "pattern": "^INT-[A-Z][A-Z0-9]*-[0-9]{3}$" }
      }
    },
    "retirement": {
      "description": "廃止(lifecycle: retired で必須)。資格情報・ACL・FW の穴を閉じる後片付けの Issue",
      "type": "object",
      "additionalProperties": false,
      "required": ["issue"],
      "properties": { "issue": { "$ref": "#/$defs/issue" } }
    },
    "onboarding": {
      "description": "既に動いている連携を後からカタログに登録する(新しいエントリを active で始めてよい。ADR-0034)",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "existing" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "external": {
      "description": "外部(SaaS のベンダーなど)が持ち主の連携・契約(ADR-0035 §8)。owner は連携に責任を持つ社内のチーム。contracts/external の契約を使う連携では必須(CC-CATALOG-007)",
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "source"],
      "properties": {
        "vendor": { "description": "契約の持ち主(ベンダー名)", "type": "string", "minLength": 1 },
        "source": { "description": "契約の出典(ベンダーの仕様の URL や版。変更を追う手がかり)", "type": "string", "minLength": 1 }
      }
    },
    "dataRetention": {
      "description": "この連携が運ぶデータの保持期間(ISO 8601 の期間。例 P7D)。トピックの retention などの設定と一致させる。個人情報を運ぶ連携では書く",
      "type": "string",
      "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?$"
    },
    "reactivation": {
      "description": "廃止の取り消し(deprecated から active に戻す。ADR-0034)",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "approver"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "approver": { "$ref": "#/$defs/approver" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "deprecated" } }, "required": ["lifecycle"] },
      "then": { "required": ["deprecation"] }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "retired" } }, "required": ["lifecycle"] },
      "then": { "required": ["retirement"] }
    },
    {
      "if": { "properties": { "style": { "enum": ["event", "cdc", "mqtt"] } } },
      "then": { "required": ["channels"], "properties": { "channels": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "issue": { "description": "GitHub の Issue(#123)", "type": "string", "pattern": "^#[0-9]+$" },
    "approver": {
      "description": "承認者(GitHub のアカウント @name かチーム team-name)",
      "type": "string",
      "pattern": "^(@[A-Za-z0-9][A-Za-z0-9-]*|team-[a-z][a-z0-9-]*)$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "system"],
      "properties": {
        "owner": { "description": "チーム単位(個人名は不可。Framework 16.2)", "type": "string", "pattern": "^team-[a-z][a-z0-9-]*$" },
        "system": { "type": "string", "minLength": 1 }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "system"],
      "properties": {
        "owner": { "type": "string", "pattern": "^team-[a-z][a-z0-9-]*$" },
        "system": { "type": "string", "minLength": 1 },
        "group": {
          "description": "Kafka の Consumer Group({service}.{purpose})。event / cdc の消費者では必須",
          "type": "string"
        }
      }
    }
  }
}
