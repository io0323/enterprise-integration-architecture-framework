{
  "name": "inventory-outbox",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "${env:DEBEZIUM_DB_PASSWORD}",
    "database.dbname": "inventory_service",
    "topic.prefix": "inventory-outbox",
    "plugin.name": "pgoutput",
    "publication.name": "eiaf_outbox",
    "publication.autocreate.mode": "disabled",
    "slot.name": "inventory_outbox",
    "table.include.list": "outbox.outbox",
    "snapshot.mode": "no_data",
    "tombstones.on.delete": "false",
    "extended.headers.enabled": "false",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "SELECT pg_logical_emit_message(true, 'eiaf-heartbeat', now()::text)",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.debezium.converters.BinaryDataConverter",
    "value.converter.delegate.converter.type": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.delegate.converter.type.schemas.enable": "false",
    "transforms": "dropMessage,outbox",
    "transforms.dropMessage.type": "org.apache.kafka.connect.transforms.Filter",
    "transforms.dropMessage.predicate": "isMessage",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "topic",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "ce_id:header:ce_id,ce_source:header:ce_source,event_type:header:ce_type,ce_time:header:ce_time,ce_specversion:header:ce_specversion,traceparent:header:traceparent,correlation_id:header:correlationid",
    "predicates": "isMessage",
    "predicates.isMessage.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isMessage.pattern": "inventory-outbox\\.message",
    "topic.creation.default.replication.factor": "1",
    "topic.creation.default.partitions": "3"
  }
}
