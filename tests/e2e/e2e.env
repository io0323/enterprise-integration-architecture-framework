# E2E 用の設定(make up ... E2E=1 が docker compose の --env-file に足す)。値は infra/local/docker-compose.yml の ${...:-既定} を上書きする。
# 秘密情報は書かない(infra/local/.env にある)。
#
# file-exchange(FileExchangeE2E。P09 ⑦)。E2E で確かめるのは「取引先の SFTP を本物に止めると、配送の失敗と Circuit Breaker の Open が
# Prometheus まで届くこと」と「戻した後に再実行で送り終えること」で、判定の仕組み(Circuit Breaker の窓と失敗率・ステップのリトライの回数)は
# 本番の既定のまま変えない。待ち時間だけを短くして、E2E の所要時間を延ばさない。
# - 到着の確認の間隔: 30 秒 → 2 秒(マニフェストを置いてから受け取りが動くまでの待ち)
FILE_EXCHANGE_POLL_INTERVAL=2s
# - 取引先の Circuit Breaker の Open の期間: 30 秒 → 5 秒(戻した後に Half-Open になるまでの待ち)
FILE_EXCHANGE_SFTP_OPEN_DURATION=5s
# - 配送のステップのリトライの最初の待ち時間: 5 秒 → 250 ミリ秒(250 ミリ秒・500 ミリ秒の後に試して、3 回で失敗にする。本番は 5 秒・10 秒)。
#   取引先の停止のシナリオは 4 つのファイルの配送を失敗させるので、待ち時間の合計が E2E の所要時間にそのまま出る
FILE_EXCHANGE_DELIVER_RETRY_DELAY=250ms
