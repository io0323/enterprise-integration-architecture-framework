        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (code) (rate(apisix_http_status{route=\"sales-order-api\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
