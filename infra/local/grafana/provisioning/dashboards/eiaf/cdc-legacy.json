      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "kafka_connect_connector_status{connector=\"legacy-juchu\"} == 1",
          "legendFormat": "コネクタ: {{status}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "kafka_connect_connector_task_status{connector=\"legacy-juchu\"} == 1",
          "legendFormat": "タスク {{task}}: {{status}}"
        }
      ]
    },
