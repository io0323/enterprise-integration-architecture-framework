# ローカル基盤の秘密情報(CLAUDE.md §5 Security / ADR-0008)。
# このファイルは変数名の一覧。値は `make env`(scripts/init-env.sh)が infra/local/.env にランダム生成する。
# infra/local/.env は .gitignore 済み。値を手で書いてコミットしないこと。
# 値が __GENERATE__ の変数はランダム生成、それ以外はそのままコピーされる。

# PostgreSQL(スーパーユーザ。アプリからは使わない)
POSTGRES_PASSWORD=__GENERATE__
# サービス別 DB(ユーザー名 = DB 名。postgres/init/10-service-databases.sh)
ORDER_DB_PASSWORD=__GENERATE__
INVENTORY_DB_PASSWORD=__GENERATE__
PAYMENT_DB_PASSWORD=__GENERATE__
SHIPPING_DB_PASSWORD=__GENERATE__
LEGACY_SIM_DB_PASSWORD=__GENERATE__
BATCH_ETL_DB_PASSWORD=__GENERATE__
FILE_EXCHANGE_DB_PASSWORD=__GENERATE__
WEBHOOK_RECEIVER_DB_PASSWORD=__GENERATE__
INTEGRATION_FLOW_DB_PASSWORD=__GENERATE__
# サービス別 DB のアプリ用のロール({name}_app。INSERT / SELECT などマイグレーションが付けた権限だけを持つ。ADR-0017)
ORDER_APP_DB_PASSWORD=__GENERATE__
INVENTORY_APP_DB_PASSWORD=__GENERATE__
PAYMENT_APP_DB_PASSWORD=__GENERATE__
SHIPPING_APP_DB_PASSWORD=__GENERATE__
LEGACY_SIM_APP_DB_PASSWORD=__GENERATE__
BATCH_ETL_APP_DB_PASSWORD=__GENERATE__
FILE_EXCHANGE_APP_DB_PASSWORD=__GENERATE__
WEBHOOK_RECEIVER_APP_DB_PASSWORD=__GENERATE__
INTEGRATION_FLOW_APP_DB_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
APICURIO_DB_PASSWORD=__GENERATE__
# Debezium がレプリケーションで使うユーザー(cdc profile。postgres/init/20-debezium.sh)
DEBEZIUM_DB_PASSWORD=__GENERATE__
# postgres-exporter のユーザー(pg_monitor だけ。cdc / order profile。postgres/init/30-monitoring.sh)
POSTGRES_EXPORTER_DB_PASSWORD=__GENERATE__
# レガシーの受注の照合のユーザー(eiaf_reconcile。t_juchu の SELECT だけ。cdc profile。postgres/init/40-reconcile.sh。ADR-0027)
LEGACY_RECONCILE_DB_PASSWORD=__GENERATE__
# レガシーの受注の部分の再同期のユーザー(eiaf_resync。signal 表の INSERT だけ。ADR-0027 §6)
LEGACY_RESYNC_DB_PASSWORD=__GENERATE__

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
# realm eiaf の client-credentials クライアント(keycloak/realm-eiaf.json)
EIAF_E2E_CLIENT_SECRET=__GENERATE__
# 2 つ目のクライアント(eiaf-e2e-b)。クライアントごとの Rate Limit と Idempotency-Key の範囲を確かめる(ADR-0023 §5)
EIAF_E2E_B_CLIENT_SECRET=__GENERATE__
# 分析のバッチ(eiaf-batch-etl)。注文の日次の集計(sales.order:report)だけを読む(ADR-0031 §6)
EIAF_BATCH_ETL_CLIENT_SECRET=__GENERATE__

# Grafana
GRAFANA_ADMIN_PASSWORD=__GENERATE__


# MQTT(iot profile)
MQTT_USERNAME=eiaf-device
MQTT_PASSWORD=__GENERATE__

# S3 互換ストレージ(file / b2b / order / batch profile。ADR-0015)。管理者(Admin)の資格情報。バケットとポリシーの作成だけに使う
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
# 監査のアンカーの書込み用。サービスごとの identity(eiaf-audit-{service})で、anchors/{service}/ の下にだけ書ける(Issue #43。ADR-0017 §7)
ORDER_AUDIT_S3_ACCESS_KEY=__GENERATE__
ORDER_AUDIT_S3_SECRET_KEY=__GENERATE__
# 監査の検査(make audit-verify)専用。バケット eiaf-audit の Read / List だけ(書き込めない。ADR-0017 §7)
AUDIT_VERIFY_S3_ACCESS_KEY=__GENERATE__
AUDIT_VERIFY_S3_SECRET_KEY=__GENERATE__
# ファイル授受(バケット eiaf-file-exchange。P09 ⑥。ADR-0032 §1)。batch-etl は受け口(inbox/sales-daily/)に書くだけ
FILE_BATCH_ETL_S3_ACCESS_KEY=__GENERATE__
FILE_BATCH_ETL_S3_SECRET_KEY=__GENERATE__
# file-exchange は受け口の検査と、archive / quarantine への移動(バケットの読み書き)。バケットの管理操作はバケットポリシーで拒否する
FILE_EXCHANGE_S3_ACCESS_KEY=__GENERATE__
FILE_EXCHANGE_S3_SECRET_KEY=__GENERATE__

# SaaS(CRM)の模擬と連携(saas profile。P10 ⑥。ADR-0035)
# CRM の API トークン(saas-mock が確かめ、integration-flow の定期の同期が使う)
SAAS_MOCK_API_TOKEN=__GENERATE__
# saas-mock の管理の API(SaaS の画面の代わり。make verify と E2E が顧客を作る・変える)
SAAS_MOCK_ADMIN_TOKEN=__GENERATE__
# Webhook の署名の鍵は値ではなくファイル(secrets/crm-webhook/。make env が作る)。差し替えを再起動なしで行うため(docs/runbooks/webhook-secret-rotation.md)
