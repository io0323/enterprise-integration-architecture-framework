{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eia.io/platform/trading-partner/ledger.v1.schema.json",
  "title": "Trading partner ledger v1",
  "description": "取引先の台帳(TPA。Framework 11.1。ADR-0040)。取引先ごとに、識別子・扱う文書・接続先(SFTP)・鍵とホスト鍵(有効期限つき)・PGP の公開鍵・合意(通貨・応答・締め時刻・SLA・再送の規則)・連絡先を持つ。秘密情報は名前だけを書き、値は SecretProvider から読む。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "company", "partners"],
  "properties": {
    "version": { "const": 1 },
    "company": {
      "description": "自社の識別子(取引先から受け取る交換の UNB の受け手、注文の NAD+SU の GLN)",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "edifact", "gln"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "edifact": { "$ref": "#/$defs/partyIdentification" },
        "gln": { "$ref": "#/$defs/gln" }
      }
    },
    "partners": {
      "type": "array",
      "items": { "$ref": "#/$defs/partner" }
    }
  },
  "$defs": {
    "secretName": {
      "description": "秘密情報の名前(値は SecretProvider から読む。ADR-0019 §6)",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "date": {
      "description": "ISO 8601 の日付(YYYY-MM-DD)",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "duration": {
      "description": "ISO 8601 の期間(例 PT4H・PT60S)",
      "type": "string",
      "pattern": "^P(?!$)([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
    },
    "gln": { "type": "string", "pattern": "^[0-9]{13}$" },
    "partyIdentification": {
      "description": "UN/EDIFACT の UNB の識別子(S002 / S003 の 0004・0010 と、識別の機関 0007)",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "qualifier"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 35 },
        "qualifier": { "type": "string", "minLength": 1, "maxLength": 4 }
      }
    },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "partner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "documents", "sftp", "agreement", "contacts"],
      "properties": {
        "id": {
          "description": "取引先の ID(メトリクスの属性と Resilience の名前に使う)",
          "type": "string",
          "pattern": "^[a-z0-9](-?[a-z0-9])*$",
          "maxLength": 32
        },
        "name": { "type": "string", "minLength": 1 },
        "edifact": {
          "description": "取引先が送る交換の UNB の送り手(EDI の文書を受け取る取引先では必須)",
          "$ref": "#/$defs/partyIdentification"
        },
        "documents": {
          "description": "扱う文書(連携カタログの ID と向き。カタログの粒度は文書の種類 × 向き。ADR-0041 §7)",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["integration", "direction"],
            "properties": {
              "integration": { "type": "string", "pattern": "^INT-[A-Z][A-Z0-9]*-[0-9]{3}$" },
              "direction": { "enum": ["inbound", "outbound"] },
              "dataset": {
                "description": "送るファイルのデータセット({system}_{dataset}。ファイルの連携だけ)",
                "type": "string",
                "pattern": "^[a-z0-9]+_[a-z0-9_]+$"
              }
            }
          }
        },
        "sftp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "username", "hostKey", "clientKey", "directories"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string", "minLength": 1 },
            "hostKey": {
              "description": "取引先の SFTP のホスト鍵(known_hosts の行。事前に登録したものだけを信用する。ADR-0032 §8)。validUntil は TPA で合意した差し替えの期日(SSH の鍵そのものには期限がない)",
              "type": "object",
              "additionalProperties": false,
              "required": ["knownHostsSecret", "validUntil"],
              "properties": {
                "knownHostsSecret": { "$ref": "#/$defs/secretName" },
                "validUntil": { "$ref": "#/$defs/date" }
              }
            },
            "clientKey": {
              "description": "自社が接続に使うクライアントの鍵。validUntil は TPA で合意した差し替えの期日",
              "type": "object",
              "additionalProperties": false,
              "required": ["privateKeySecret", "validUntil"],
              "properties": {
                "privateKeySecret": { "$ref": "#/$defs/secretName" },
                "passphraseSecret": { "$ref": "#/$defs/secretName" },
                "validUntil": { "$ref": "#/$defs/date" }
              }
            },
            "directories": {
              "description": "取引先の SFTP のディレクトリ(絶対パス)。outbound = 送るファイル、inbound = 取引先が置く文書、acknowledgements = 返す応答",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "outbound": { "$ref": "#/$defs/absolutePath" },
                "inbound": { "$ref": "#/$defs/absolutePath" },
                "acknowledgements": { "$ref": "#/$defs/absolutePath" }
              }
            },
            "completion": {
              "description": "取引先が置いたファイルが書き終わったかの判断(取引先はマニフェストを置かない前提。ADR-0040 §4)",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "temporarySuffix"],
                  "properties": {
                    "method": { "const": "rename" },
                    "temporarySuffix": { "description": "書いている間の名前の末尾(例 .part)。この名前のファイルは拾わない", "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["method", "quietPeriod"],
                  "properties": {
                    "method": { "const": "stable" },
                    "quietPeriod": { "description": "大きさと更新の時刻が変わらない時間", "$ref": "#/$defs/duration" }
                  }
                }
              ]
            }
          }
        },
        "pgp": {
          "description": "取引先の PGP の公開鍵(送るファイルの暗号化。ADR-0032 §8)。validUntil は TPA で合意した差し替えの期日(鍵の中の期限が早ければ、そちらで監視する)",
          "type": "object",
          "additionalProperties": false,
          "required": ["publicKeySecret", "validUntil"],
          "properties": {
            "publicKeySecret": { "$ref": "#/$defs/secretName" },
            "validUntil": { "$ref": "#/$defs/date" }
          }
        },
        "agreement": {
          "description": "取引先との合意(TPA)",
          "type": "object",
          "additionalProperties": false,
          "required": ["currencies", "acknowledgements", "cutoff", "sla", "resend"],
          "properties": {
            "currencies": {
              "description": "注文で使ってよい通貨(ISO 4217)",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
            },
            "acknowledgements": {
              "type": "object",
              "additionalProperties": false,
              "required": ["positiveAperak", "aperakDeadline"],
              "properties": {
                "positiveAperak": { "description": "業務の受け付けに成功したときにも APERAK(AP)を返すか", "type": "boolean" },
                "aperakDeadline": { "description": "受け取ってから業務の応答(APERAK)を返すまでの期限", "$ref": "#/$defs/duration" }
              }
            },
            "cutoff": {
              "description": "その日の受注として扱う締め時刻",
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "timeZone"],
              "properties": {
                "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                "timeZone": { "description": "IANA のタイムゾーン(例 Asia/Tokyo)", "type": "string", "minLength": 1 }
              }
            },
            "sla": {
              "type": "object",
              "additionalProperties": false,
              "required": ["syntaxAcknowledgement"],
              "properties": {
                "syntaxAcknowledgement": { "description": "書き終わったファイルを見つけてから CONTRL を返すまで", "$ref": "#/$defs/duration" }
              }
            },
            "resend": { "description": "再送の規則(文書で合意した内容の要約)", "type": "string", "minLength": 1 }
          }
        },
        "contacts": {
          "description": "連絡先(障害時の連絡を含む)。個人ではなく役割の窓口を書く",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name", "email"],
            "properties": {
              "role": { "enum": ["business", "operations", "incident"] },
              "name": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
              "phone": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
